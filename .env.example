# Copy to .env for local development. Never commit the filled-in file.
# In production these are injected as secrets (fly secrets set / Secret Manager),
# not as a file baked into the image.

# --- Slack (Socket Mode: no public URL, no signing secret needed for events) ---
# Bot User OAuth Token, from OAuth & Permissions. Scopes: files:read, chat:write, im:write
SLACK_BOT_TOKEN=xoxb-000000000000-000000000000-xxxxxxxxxxxxxxxxxxxxxxxx
# App-Level Token with connections:write, from Basic Information > App-Level Tokens
SLACK_APP_TOKEN=xapp-1-A00000000-0000000000000-xxxxxxxxxxxxxxxxxxxxxxxx

# --- OCR sidecar (localhost only, never exposed) ---
OCR_SIDECAR_URL=http://127.0.0.1:8000
OCR_TIMEOUT_MS=20000

# --- AI fallback (optional; disabled by default) ---
# When true, images that fail deterministic OCR + check-digit repair are sent to
# the Anthropic API. This moves document data outside your perimeter — enable
# only with an explicit data-processing decision. See docs/SECURITY.md.
AI_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Behaviour ---
# dm_only  : only accept uploads in a DM with the bot (recommended, default)
# allowlist: also accept uploads in ALLOWED_CHANNEL_IDS
INTAKE_MODE=dm_only
ALLOWED_CHANNEL_IDS=

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_PER_USER_PER_MINUTE=10
MAX_CONCURRENT_JOBS=2

LOG_LEVEL=info
NODE_ENV=development
