{
  "name": "slack-passbot",
  "version": "0.1.0",
  "private": true,
  "description": "Slack bot that extracts ICAO 9303 MRZ data from document photos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@slack/bolt": "^4.4.0",
    "@slack/types": "^2.16.0",
    "@slack/web-api": "^7.9.0",
    "file-type": "^21.0.0",
    "mrz": "^5.0.0",
    "p-queue": "^8.1.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
